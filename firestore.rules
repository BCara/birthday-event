rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function eventPublished(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.published == true;
    }

    function isEventHost(eventId) {
      return request.auth != null
        && get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid;
    }

    // Caps payload sizes on guest-writable docs to limit abuse / doc bloat.
    // Lenient on shape (fields may be absent) so legitimate writes aren't blocked.
    function rsvpWithinLimits() {
      return request.resource.data.eventId is string
        && (!('parentName' in request.resource.data) || request.resource.data.parentName.size() <= 200)
        && (!('childName' in request.resource.data)  || request.resource.data.childName.size() <= 200)
        && (!('email' in request.resource.data)      || request.resource.data.email.size() <= 320)
        && (!('phone' in request.resource.data)      || request.resource.data.phone.size() <= 50)
        && (!('dietary' in request.resource.data)    || request.resource.data.dietary.size() <= 2000)
        && (!('comments' in request.resource.data)   || request.resource.data.comments.size() <= 4000)
        && (!('siblings' in request.resource.data)   || request.resource.data.siblings.size() <= 30);
    }

    // ---- users ----
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- events ----
    match /events/{eventId} {
      // host can do anything to their own events
      allow read, update, delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;
      // anyone can read a published event (for the guest landing page)
      allow read: if resource.data.published == true;
      // authenticated users can create
      allow create: if request.auth != null;
    }

    // ---- rsvps ----
    match /rsvps/{rsvpId} {
      // Only the event host may list/enumerate RSVPs. Guests must use the
      // `lookupRsvp` Cloud Function (which requires name + matching contact)
      // to find their own RSVP — this prevents bulk PII harvesting.
      allow list: if isEventHost(resource.data.eventId);

      // Bearer-token model: the document ID is an unguessable 20-char key.
      // A guest who holds it (their own localStorage / edit link) may read and
      // update that single RSVP. Hosts can always read/update their event's RSVPs.
      allow get:    if true;
      allow update: if rsvpWithinLimits();

      // Guests may NOT delete; only the host can.
      allow delete: if isEventHost(resource.data.eventId);

      // Anyone can create an RSVP for a published event (size-validated).
      allow create: if eventPublished(request.resource.data.eventId)
        && rsvpWithinLimits();
    }

    // ---- memories (private capsule — host only) ----
    match /memories/{memoryId} {
      // Private capsule: ONLY the event host can read submissions. Guests submit
      // blind (create-only) and never see other guests' memories. The media files
      // live in Storage behind unguessable URLs whose only copy is stored on these
      // host-only docs — so a guest cannot enumerate or read others' photos.
      allow read: if isEventHost(resource.data.eventId);

      // Guests can submit a memory for a published event (size-validated).
      allow create: if eventPublished(request.resource.data.eventId)
        && request.resource.data.eventId is string
        && (!('message' in request.resource.data)    || request.resource.data.message.size() <= 2000)
        && (!('authorName' in request.resource.data) || request.resource.data.authorName.size() <= 100);

      // Only the host can edit or delete memories.
      allow update, delete: if isEventHost(resource.data.eventId);
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
