rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users ----
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- events ----
    match /events/{eventId} {
      // host can do anything to their own events
      allow read, update, delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;
      // anyone can read a published event (for the guest landing page)
      allow read: if resource.data.published == true;
      // authenticated users can create
      allow create: if request.auth != null;
    }

    // ---- rsvps ----
    match /rsvps/{rsvpId} {
      // Host has full access to all RSVPs for their event, and guests can list/query RSVPs for published events
      allow list: if (request.auth != null
        && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.hostId
           == request.auth.uid) || (
             resource.data.eventId != null &&
             get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.published == true
           );
      
      allow get, update, delete: if (request.auth != null
        && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.hostId
           == request.auth.uid) || true; 
           // Note: guests can 'get' and 'update' if they have the document ID. 
           // We allow 'true' for get/update/delete here because Firestore document IDs 
           // act as a private key for unauthenticated guest access.

      // Anyone can create an RSVP if the event is published
      allow create: if
        get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.published == true;
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
