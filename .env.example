# Copy this file to .env and fill in your Firebase project values.
# Get them from Firebase Console → Project Settings → Your Apps

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: GA4 Measurement ID (Firebase Console → Project Settings → your Web app,
# or Analytics → Data Streams). Until this is set, all analytics tracking is a no-op.
VITE_FIREBASE_MEASUREMENT_ID=
